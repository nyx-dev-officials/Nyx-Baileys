{
  "name": "nyx-baileys",
  "version": "0.3.1",
  "description": "Hyper-modular WhatsApp client framework — upstream Baileys engine, decorated at runtime. No node_modules edits.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./lite": {
      "types": "./dist/lite.d.ts",
      "import": "./dist/lite.js"
    },
    "./lite/*": "./dist/*.js",
    "./package.json": "./package.json",
    "./core/*": "./dist/core/*.js",
    "./plugins": "./dist/plugins/index.js",
    "./plugins/*": "./dist/plugins/*.js",
    "./utils/*": "./dist/utils/*.js",
    "./multi": "./dist/multi/index.js",
    "./multi/*": "./dist/multi/*.js",
    "./security": "./dist/security/index.js",
    "./integrations": "./dist/integrations/index.js",
    "./integrations/*": "./dist/integrations/*.js",
    "./antiban": "./dist/antiban/index.js",
    "./antiban/*": "./dist/antiban/*.js",
    "./bot": "./dist/bot/index.js",
    "./bot/*": "./dist/bot/*.js",
    "./cli": "./dist/cli/index.js",
    "./cli/*": "./dist/cli/*.js",
    "./toolkit": "./dist/toolkit/index.js",
    "./toolkit/*": "./dist/toolkit/*",
    "./features": {
      "types": "./dist/features/index.d.ts",
      "import": "./dist/features/index.js"
    },
    "./features/*": "./dist/features/*.js"
  },
  "bin": {
    "flux": "./bin/flux.js",
    "nyx-baileys": "./bin/nyx-baileys.js"
  },
  "files": [
    "dist",
    "README.md",
    "docs"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "npm run clean && tsc -p tsconfig.json && npm run build:assets",
    "check": "tsc -p tsconfig.json --noEmit",
"build:assets": "node -e \"require('fs').cpSync('src/assets','dist/assets',{recursive:true})\"",
    "lint": "tsc -p tsconfig.json --noEmit",
    "test": "node --test ./tests/*.test.js",
    "demo": "node dist/index.js",
    "bench": "node --expose-gc bench/message-throughput.mjs",
    "bench:plugins": "node --expose-gc bench/plugin-profile.mjs",
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "prepublishOnly": "npm run clean && npm run build && node scripts/check-exports.mjs",
    "setup": "node scripts/setup-flux.mjs",
    "pair": "flux",
    "status": "node bin/nyx-baileys.js status",
    "send": "node bin/nyx-baileys.js send",
    "health": "node bin/nyx-baileys.js health",
    "sessions": "node bin/nyx-baileys.js sessions",
    "cli": "node bin/nyx-baileys.js",
    "wizard": "flux"
  },
  "keywords": [
    "whatsapp",
    "baileys",
    "baileys-fork",
    "multi-device",
    "native-flow",
    "anti-spam"
  ],
  "license": "MIT",
  "devDependencies": {
    "jsqr": "^1.4.0",
    "typescript": "^5.9.2"
  },
  "dependencies": {
    "@inquirer/prompts": "^8.7.3",
    "@whiskeysockets/baileys": ">=7.0.0-rc.14",
    "link-preview-js": "^3.2.0"
  },
  "peerDependencies": {
    "@whiskeysockets/baileys": ">=7.0.0-rc.14"
  },
  "peerDependenciesMeta": {
    "@whiskeysockets/baileys": {
      "optional": false
    }
  }
}

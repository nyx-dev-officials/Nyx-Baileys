# Archil — persistent, shared filesystem for agent/sandbox workspaces.
# Copy this file to `.env` and fill in a real key. `.env` is gitignored;
# NEVER commit real credentials.
#
# 1. Create an account and an API key at:
#    https://console.archil.com/
# 2. Set the key and the region closest to where your compute runs.
#    Serverless exec is supported in: aws-us-east-1, aws-us-west-2, aws-eu-west-1
#    (GCP regions do not support `disk exec`.)

ARCHIL_API_KEY=
ARCHIL_REGION=aws-us-east-1

# ─────────────────────────────────────────────────────────────────────
# Nyx-Baileys — AI providers
# Keys are read from the environment, never hardcoded. A key in source is a
# key in git history, and this is a published package: npm publish would ship
# it. Set these in .env (git-ignored) or your shell.
# ─────────────────────────────────────────────────────────────────────

# OpenRouter — powers the FREE models in FREE_MODELS (src/toolkit/ai/providers.ts).
# Default: nvidia/nemotron-3-ultra-550b-a55b:free  (1M context, ~3s)
OPENROUTER_API_KEY=

# Alternatives. Any provider works; free models are listed in FREE_MODELS.
# GROQ_API_KEY=
# GEMINI_API_KEY=
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=

# Pollinations — image generation. Note: audio/video return 402 on a free key.
# POLLINATIONS_KEY=

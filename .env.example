# Archil — persistent, shared filesystem for agent/sandbox workspaces.
# Copy this file to `.env` and fill in a real key. `.env` is gitignored;
# NEVER commit real credentials.
#
# 1. Create an account and an API key at:
#    https://console.archil.com/
# 2. Set the key and the region closest to where your compute runs.
#    Serverless exec is supported in: aws-us-east-1, aws-us-west-2, aws-eu-west-1
#    (GCP regions do not support `disk exec`.)

ARCHIL_API_KEY=
ARCHIL_REGION=aws-us-east-1
